{
  "name": "@hey-research-lab/rhchain-registry",
  "version": "0.1.1",
  "description": "A community-maintained, CI-validated registry of Robinhood Chain infrastructure (DEXes, factories, launchpads, protocols, explorers, RPC) with public sources for every entry.",
  "license": "MIT",
  "author": "HEY Research Lab",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./registry.json": "./dist/registry.json",
    "./addresses.json": "./dist/addresses.json",
    "./schema/registry-entry.v1.json": "./schema/registry-entry.v1.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "rhchain-registry": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hey-research-lab/rhchain-registry.git"
  },
  "homepage": "https://heyresearch.xyz/developers",
  "bugs": {
    "url": "https://github.com/hey-research-lab/rhchain-registry/issues"
  },
  "keywords": [
    "hey-research",
    "robinhood-chain",
    "registry",
    "evm",
    "json-schema",
    "developer-tools",
    "web3",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.15.1",
  "scripts": {
    "build": "pnpm build:data && tsup",
    "build:data": "tsx scripts/build-data.ts",
    "check:fresh": "tsx scripts/build-data.ts --check",
    "validate": "tsx scripts/build-data.ts --validate-only",
    "format:registry": "tsx scripts/build-data.ts --format",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "scan": "node scripts/scan.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "ajv": "^8.17.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1"
    }
  }
}
